<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>PocketSmart AI</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
    <h1>💰 PocketSmart AI</h1>
    <p>Your Smart Budget & Recommendation Assistant</p>
</header>

<main>

    <section id="dashboard">

        <h2>📊 Financial Dashboard</h2>

        <div class="dashboard">

            <div class="card">
                <h3>Total Income</h3>
                <p id="totalIncome">₹0</p>
            </div>

            <div class="card">
                <h3>Total Expenses</h3>
                <p id="totalExpense">₹0</p>
            </div>

            <div class="card">
                <h3>Remaining Balance</h3>
                <p id="remainingBalance">₹0</p>
            </div>

            <div class="card">
                <h3>Monthly Budget</h3>
                <p id="monthlyBudget">₹0</p>
            </div>

        </div>

    </section>

    <section class="form-section">

        <h2>💵 Add Income</h2>

        <form id="incomeForm">

            <label>Income Amount</label>

            <input
                type="number"
                id="incomeAmount"
                placeholder="Enter income amount"
                required
            >

            <label>Income Source</label>

            <select id="incomeSource">
                <option value="Salary">Salary</option>
                <option value="Pocket Money">Pocket Money</option>
                <option value="Business">Business</option>
                <option value="Freelance">Freelance</option>
                <option value="Other">Other</option>
            </select>

            <button type="submit">Add Income</button>

        </form>

    </section>

    <section class="form-section">

        <h2>💸 Add Expense</h2>

        <form id="expenseForm">

            <label>Expense Amount</label>

            <input
                type="number"
                id="expenseAmount"
                placeholder="Enter expense amount"
                required
            >

            <label>Expense Category</label>

            <select id="expenseCategory">
                <option value="Food">Food</option>
                <option value="Travel">Travel</option>
                <option value="Shopping">Shopping</option>
                <option value="Education">Education</option>
                <option value="Entertainment">Entertainment</option>
                <option value="Bills">Bills</option>
                <option value="Health">Health</option>
                <option value="Other">Other</option>
            </select>

            <label>Description</label>

            <input
                type="text"
                id="expenseDescription"
                placeholder="Example: Lunch"
            >

            <button type="submit">Add Expense</button>

        </form>

    </section>

    <section class="form-section">

        <h2>🎯 Set Monthly Budget</h2>

        <form id="budgetForm">

            <label>Budget Amount</label>

            <input
                type="number"
                id="budgetAmount"
                placeholder="Example: 10000"
                required
            >

            <button type="submit">Set Budget</button>

        </form>

    </section>

    <section>

        <h2>📋 Recent Transactions</h2>

        <table>

            <thead>
                <tr>
                    <th>Type</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Amount</th>
                </tr>
            </thead>

            <tbody id="transactionTable">

                <tr>
                    <td colspan="4">No transactions yet</td>
                </tr>

            </tbody>

        </table>

    </section>

    <section class="ai-section">

        <h2>🤖 PocketSmart AI Recommendation</h2>

        <div class="ai-box">

            <p id="aiRecommendation">
                Add your income and expenses to receive
                personalized budget recommendations.
            </p>

        </div>

    </section>

    <section>

        <h2>💡 Smart Budget Tips</h2>

        <div class="tips">

            <div class="tip">
                📊 Track your daily expenses.
            </div>

            <div class="tip">
                🎯 Set a realistic monthly budget.
            </div>

            <div class="tip">
                💰 Save a portion of your income.
            </div>

            <div class="tip">
                🤖 Use recommendations to understand spending.
            </div>

        </div>

    </section>

</main>

<footer>

    <h3>💰 PocketSmart AI</h3>

    <p>Your Smart Budget & Recommendation Assistant</p>

    <p>© 2026 PocketSmart AI</p>

</footer>

<script src="script.js"></script>

</body>
</html>